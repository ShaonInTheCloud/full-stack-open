@base = http://localhost:3001
@personId = REPLACE_WITH_ID_FROM_CREATE_OR_LIST_RESPONSE

### Read all entries
GET {{base}}/api/persons

### Count and server time
GET {{base}}/info

### Add an entry (repeat to test duplicate rejection)
POST {{base}}/api/persons
Content-Type: application/json

{"name":"Grace Hopper","number":"040-1234567"}

### Read one entry using its MongoDB ID
GET {{base}}/api/persons/{{personId}}

### Update the number
PUT {{base}}/api/persons/{{personId}}
Content-Type: application/json

{"number":"09-7654321"}

### Invalid number
PUT {{base}}/api/persons/{{personId}}
Content-Type: application/json

{"number":"123"}

### Invalid entry
POST {{base}}/api/persons
Content-Type: application/json

{"name":"Missing Number"}

### Delete an entry (a repeated request returns 404)
DELETE {{base}}/api/persons/{{personId}}

### Malformed ID
GET {{base}}/api/persons/not-an-id
